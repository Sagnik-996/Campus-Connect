# Supabase Dashboard → Connect → Connection pooling → URI. Use the pooler URI
# (port 6543), not a copied local IPv6 address. This works from Render and from
# networks that cannot reach Supabase's direct database host.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Use false only for a local PostgreSQL server without TLS.
# DATABASE_SSL=false

# Set a long, random value in Render; never use the fallback in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: only needed when hosting the frontend on a different domain.
# FRONTEND_URL=https://your-frontend.example.com
NODE_ENV=production
